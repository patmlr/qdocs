---
layout: null
---
{%- comment -%}
The search index of the top navigation search, loaded by script.js on first use. Theme assets are rendered after the
pages of the site, so `content` is the rendered page body without its layout.
{%- endcomment -%}
[
{%- assign pages = site.html_pages | where_exp: "p", "p.title" -%}
{%- for p in pages %}
  {"title": {{ p.title | jsonify }}, "url": {{ p.url | relative_url | jsonify }}, "text": {{ p.content | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
